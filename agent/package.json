{
  "name": "agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./protocol": "./src/protocol.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "start": "tsx --env-file-if-exists=.env src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "vite build",
    "start:bundle": "node --env-file-if-exists=.env dist/agent.mjs"
  },
  "dependencies": {
    "mqtt": "^5.16.0",
    "systeminformation": "^5.33.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "aedes": "^1.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
