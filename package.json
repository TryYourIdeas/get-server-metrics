{
  "name": "computer-usage",
  "type": "module",
  "private": true,
  "workspaces": [
    "agent",
    "event-monitor",
    "dashboard"
  ],
  "scripts": {
    "build": "npm --workspace dashboard run build",
    "dev": "npm --workspace dashboard run dev",
    "monitor": "npm --workspace event-monitor run start",
    "monitor:typecheck": "npm --workspace event-monitor run typecheck",
    "agent": "npm --workspace agent run start",
    "generate": "npm --workspace dashboard run generate",
    "preview": "npm --workspace dashboard run preview",
    "postinstall": "npm --workspace dashboard run prepare",
    "test": "vitest run",
    "db:up": "docker compose up -d",
    "db:generate": "drizzle-kit generate --config shared/drizzle.config.ts"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-orm": "^0.45.3",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "vitest": "^5.0.2"
  }
}
