# Event monitor for the test stack: subscribes to the agents' MQTT topics and stores readings in Postgres.
# Build context is the repository root (the monitor imports ../shared and the agent's protocol).
FROM node:22-bookworm-slim
WORKDIR /app
# All workspace manifests are needed so the lockfile matches; only the monitor's dependencies are installed.
COPY package.json package-lock.json ./
COPY agent/package.json agent/
COPY event-monitor/package.json event-monitor/
COPY dashboard/package.json dashboard/
RUN npm ci --workspace event-monitor --ignore-scripts
COPY agent agent
COPY shared shared
COPY event-monitor event-monitor
WORKDIR /app/event-monitor
CMD ["node", "--import", "tsx", "src/main.ts"]
